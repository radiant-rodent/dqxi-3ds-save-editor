<Window x:Class="SaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SaveEditor"
        Title="DQXI Save Editor" Width="1240" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static local:MainWindow.OpenCmd}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SaveCmd}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.SaveAsCmd}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.OpenCmd}" Executed="OnOpen" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveCmd}" Executed="OnSave" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCmd}" Executed="OnSaveAs" />
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <!-- Item Bag / Equipment Bag -->
        <DataTemplate DataType="{x:Type local:BagVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Note}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name or category" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Add item…" Style="{StaticResource Primary}" Click="OnBagAdd" />
                        <Button Content="Remove" Click="OnBagRemove" />
                        <Button Content="Set count of selected…" Click="OnBagSetCount" />
                        <Button Content="Sort by category" Click="OnBagSort" Margin="0" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectionChanged="OnBagSelection">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTemplateColumn Header="Forged" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ForgeChoices}" SelectedIndex="{Binding ForgeLevel, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanForge}" MinHeight="24" Padding="6,1"
                                              ToolTip="Fun-Size Forge level (+1 to +3 are separate items in the save)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="180" />
                        <DataGridTextColumn Header="Count" Width="90"
                                            Binding="{Binding Count, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="No." Binding="{Binding Id}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Key Items / Recipe books -->
        <DataTemplate DataType="{x:Type local:OwnedListVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Note}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Own all" Click="OnOwnAll" />
                        <Button Content="Own none" Click="OnOwnNone" Margin="0" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Owned" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              IsChecked="{Binding Owned, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="40" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Obtained as" Binding="{Binding Order}" IsReadOnly="True" Width="100" />
                        <DataGridTextColumn Header="No." Binding="{Binding Id}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Accolades / Item List -->
        <DataTemplate DataType="{x:Type local:FlagListVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Note}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Margin="14,0,0,0" Content="Only set" IsChecked="{Binding OnlySet}" />
                    <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="Set all" Click="OnFlagsAll" />
                        <Button Content="Clear all" Click="OnFlagsNone" Margin="0" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Set" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Set, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="260" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Detail}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="No." Binding="{Binding Id}" IsReadOnly="True" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Item List: one row per item, forged versions as extra columns -->
        <DataTemplate DataType="{x:Type local:ObtainedListVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="Item List" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Items ever obtained (Info → Item List). Forged +1 to +3 versions are separate entries in the game's list." />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name or category" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Margin="14,0,0,0" Content="Only obtained" IsChecked="{Binding OnlySet}" />
                    <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="Set all" Click="OnObtainedAll" ToolTip="Every item, without the forged versions" />
                        <Button Content="Set all + forged" Click="OnObtainedAllForged" />
                        <Button Content="Clear all" Click="OnObtainedNone" Margin="0" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="170" />
                        <DataGridTemplateColumn Header="Obtained" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Set, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="+1" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Set1, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding Has1, Converter={StaticResource BoolVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="+2" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Set2, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding Has2, Converter={StaticResource BoolVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="+3" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Set3, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding Has3, Converter={StaticResource BoolVis}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="No." Binding="{Binding Id}" IsReadOnly="True" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Story chapters -->
        <DataTemplate DataType="{x:Type local:StoryVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="Story" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Story chapters in game order. Each has a step that counts up while it plays (255 = not started, 34 = finished) and 19 sub-flag bytes. Skipping ahead here does not move you or give rewards; the game may get confused, so keep a backup." />
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource Muted}" FontWeight="SemiBold" Text="{Binding Summary}" />
                <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="40" />
                        <DataGridTextColumn Header="Chapter" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTemplateColumn Header="Finished" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Finished, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="140" />
                        <DataGridTextColumn Header="Step" Width="60"
                                            Binding="{Binding Step, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="Sub-flags (hex)" Width="330" FontFamily="Consolas"
                                            Binding="{Binding SubFlags, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Side quests -->
        <DataTemplate DataType="{x:Type local:QuestListVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="Quests" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Side quests in Quest Catalogue order (Info → Quest Catalogue). Setting one to Cleared does not give its reward; set it to 'Achieved, report back' and talk to the client instead." />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Margin="14,0,0,0" Content="Only available" IsChecked="{Binding OnlyAvailable}" />
                    <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="40" />
                        <DataGridTextColumn Header="Quest" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Part" Binding="{Binding Part}" IsReadOnly="True" Width="90" />
                        <DataGridTemplateColumn Header="State" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                                              MinHeight="24" Padding="6,1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Enabled" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Cleared bit at 0xC7A8 (SetQuestEnableFlag); a set bit blocks the quest" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Byte / u32 tables: global flags, counters, tutorials -->
        <DataTemplate DataType="{x:Type local:ValueListVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{Binding Note}" />
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name or number" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Margin="14,0,0,0" Content="Only non-zero" IsChecked="{Binding OnlySet}" />
                    <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No." Binding="{Binding Id}" IsReadOnly="True" Width="56" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                        <DataGridTextColumn Header="Value" Width="80"
                                            Binding="{Binding Value, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="Where the game uses it" Binding="{Binding Detail}" IsReadOnly="True" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <!-- Monsters defeated -->
        <DataTemplate DataType="{x:Type local:DefeatListVM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource H1}" Text="Monsters" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Defeat counts behind Info, Monster List. Some monsters have several entries (for example a 2D and a 3D version); the game adds them up." />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Tag="Filter by name" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Grid.Column="1" Margin="14,0,0,0" Content="Only defeated" IsChecked="{Binding OnlySet}" />
                    <TextBlock Grid.Column="2" Margin="14,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Summary}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Battles won" />
                        <TextBox Width="90" Text="{Binding BattlesWon, ValidatesOnExceptions=True}" />
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding View}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Monster" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Defeated" Width="110"
                                            Binding="{Binding Count, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="Entry" Binding="{Binding Id}" IsReadOnly="True" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{StaticResource Sidebar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="22,22,18,18">
                <TextBlock Text="DQXI" Foreground="#7F93C4" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="Save Editor" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="SideFile" Foreground="{StaticResource SidebarInk}" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
            <ListBox x:Name="Nav" Grid.Row="1" Style="{StaticResource NavList}" SelectionChanged="OnNav">
                <ListBoxItem Content="Overview" Tag="PageGame" />
                <ListBoxItem Content="Party" Tag="PageParty" />
                <ListBoxItem Content="Item Bag" Tag="PageItemBag" />
                <ListBoxItem Content="Equipment Bag" Tag="PageEquipBag" />
                <ListBoxItem Content="Key Items" Tag="PageKeyItems" />
                <ListBoxItem Content="Recipe Books" Tag="PageRecipes" />
                <ListBoxItem Content="Story" Tag="PageStory" />
                <ListBoxItem Content="Quests" Tag="PageQuests" />
                <ListBoxItem Content="Zoom destinations" Tag="PageZoom" />
                <ListBoxItem Content="Monsters" Tag="PageMonsters" />
                <ListBoxItem Content="Accolades" Tag="PageAccolades" />
                <ListBoxItem Content="Item List" Tag="PageItemList" />
                <ListBoxItem Content="Flags and counters" Tag="PageFlags" />
                <ListBoxItem Content="Raw data" Tag="PageRaw" />
            </ListBox>
            <StackPanel Grid.Row="2" Margin="18">
                <TextBlock x:Name="SideData" Foreground="#8C96AA" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FileTitle" FontSize="14" FontWeight="SemiBold" Text="No file open" />
                        <TextBlock x:Name="FilePath" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Open…" Click="OnOpen" ToolTip="Ctrl+O" />
                        <Button x:Name="RevertButton" Content="Revert" Click="OnRevert" ToolTip="Reload the file and drop unsaved changes" />
                        <Button x:Name="SaveAsButton" Content="Save as…" Click="OnSaveAs" ToolTip="Ctrl+Shift+S" />
                        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" Click="OnSave" Margin="0"
                                ToolTip="Ctrl+S. Writes the file and keeps a .bak copy of the original next to it." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Style="{StaticResource H1}" Text="Open a save slot" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,18"
                           Text="Pick Data0, Data1 or Data2 from the game's save folder (Azahar: sdmc\Nintendo 3DS\…\title\00040000\00199200\data\00000001). You can also drop the file on this window." />
                <Button Content="Open save…" Style="{StaticResource Primary}" HorizontalAlignment="Center" Click="OnOpen" Margin="0" />
            </StackPanel>

            <Grid x:Name="Pages" Grid.Row="1" Visibility="Collapsed">

                <!-- Overview -->
                <ScrollViewer x:Name="PageGame" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24" MaxWidth="980" HorizontalAlignment="Left" DataContext="{Binding Game}">
                        <TextBlock Style="{StaticResource H1}" Text="Overview" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18" Text="Values for the whole save slot." />

                        <UniformGrid Columns="3" Margin="0,0,-14,0">
                            <Border Style="{StaticResource CardBox}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Hero" />
                                    <TextBox FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" MaxLength="15"
                                             Text="{Binding HeroName, ValidatesOnExceptions=True}" ToolTip="Up to 6 characters" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Gold" />
                                    <TextBox FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                                             Text="{Binding Gold, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" Margin="0,0,14,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Text="Play time (hours : minutes : seconds)" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBox Width="70" FontSize="18" FontWeight="SemiBold" Text="{Binding Hours, ValidatesOnExceptions=True}" />
                                        <TextBlock Text=":" FontSize="18" Margin="6,0" VerticalAlignment="Center" />
                                        <TextBox Width="56" FontSize="18" FontWeight="SemiBold" Text="{Binding Minutes, ValidatesOnExceptions=True}" />
                                        <TextBlock Text=":" FontSize="18" Margin="6,0" VerticalAlignment="Center" />
                                        <TextBox Width="56" FontSize="18" FontWeight="SemiBold" Text="{Binding Seconds, ValidatesOnExceptions=True}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Characters" />
                                <ItemsControl x:Name="PartySummary">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,10,10" Padding="14,10" Width="200" HorizontalContentAlignment="Left"
                                                    Click="OnPartyCard" Tag="{Binding}">
                                                <StackPanel Width="170">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Style="{StaticResource Muted}">
                                                        <Run Text="Lv" /> <Run Text="{Binding Level, Mode=OneWay}" />
                                                        <Run Text="  ·  HP" /> <Run Text="{Binding Hp, Mode=OneWay}" />
                                                        <Run Text="  ·  MP" /> <Run Text="{Binding Mp, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Party names" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                                           Text="{Binding NamesNote, Mode=OneWay}" />
                                <Button Content="Restore full names" HorizontalAlignment="Left" Margin="0" Click="OnRestoreNames"
                                        IsEnabled="{Binding CanRestoreNames, Mode=OneWay}"
                                        ToolTip="Saves started with an older patch keep the 6-letter names it stored. Writes each character's name from this translation (long names as the code the patch shows in full)." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Line-up" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                           Text="Order of the party; the first four fight. Characters the story has not brought in yet are skipped by the game." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="LineupList" ItemsSource="{Binding Lineup.Members}" MinHeight="120" MaxHeight="260"
                                             BorderBrush="{StaticResource Line}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Padding="4,3">
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="#69707D" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="▲ Up" Click="OnLineupUp" />
                                            <Button Content="▼ Down" Click="OnLineupDown" />
                                            <Button Content="Remove" Click="OnLineupRemove" Margin="0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox x:Name="LineupAdd" Width="220" ItemsSource="{Binding Lineup.Available}" DisplayMemberPath="Title" />
                                            <Button Content="Add" Margin="8,0,0,0" Click="OnLineupAdd" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Medals, tokens and travel" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Mini Medals" Margin="0,0,0,4" />
                                        <TextBox Width="120" Text="{Binding MiniMedals, ValidatesOnExceptions=True}" ToolTip="0x6FE4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Casino tokens" Margin="0,0,0,4" />
                                        <TextBox Width="120" Text="{Binding CasinoTokens, ValidatesOnExceptions=True}" ToolTip="0x6FF4, at most 9,999,999" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Evac return point" Margin="0,0,0,4" />
                                        <TextBox Width="80" Text="{Binding EvacPoint, ValidatesOnExceptions=True}" ToolTip="0x6FE2 (SetRiremitoPoint): where Evac takes you" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="Zoom destinations are on their own page." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="System settings" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Battle speed" Margin="0,0,0,4" />
                                        <ComboBox Width="140" SelectedIndex="{Binding BattleSpeed}">
                                            <ComboBoxItem Content="Fast" />
                                            <ComboBoxItem Content="Plain" />
                                            <ComboBoxItem Content="Slow" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Music volume" Margin="0,0,0,4" />
                                        <ComboBox Width="100" SelectedIndex="{Binding Bgm}"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /></ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Sound volume" Margin="0,0,0,4" />
                                        <ComboBox Width="100" SelectedIndex="{Binding Sfx}"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /></ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Style="{StaticResource Muted}" Text="Tilt camera" Margin="0,0,0,4" />
                                        <ComboBox Width="140" SelectedIndex="{Binding TiltCamera}">
                                            <ComboBoxItem Content="Normal" />
                                            <ComboBoxItem Content="Inverted" />
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource H2}" Text="Settings and profile" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Display mode" />
                                <ComboBox x:Name="DisplayModeBox" Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          SelectedIndex="{Binding DisplayMode}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Profile name" />
                                <TextBox Grid.Row="2" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="7"
                                         Text="{Binding ProfileName}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Profile message" />
                                <TextBox Grid.Row="3" Grid.Column="1" Width="420" HorizontalAlignment="Left" Margin="0,0,0,8" MaxLength="24"
                                         Text="{Binding ProfileMessage}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Location on the slot menu" />
                                <TextBox Grid.Row="4" Grid.Column="1" Width="420" HorizontalAlignment="Left" MaxLength="32"
                                         Text="{Binding SaveLocation}"
                                         ToolTip="Only the text the save menu shows; the game sets it again when you save." />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource H2}" Text="Position" Margin="0" />
                                    <TextBlock Style="{StaticResource Muted}" Text="Where the party stands when the slot loads. Change only to unstick a save; a bad position can drop you out of the map." />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Area / room" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Width="100" Text="{Binding Area, ValidatesOnExceptions=True}" />
                                    <TextBox Width="100" Margin="8,0,0,0" Text="{Binding Room, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="X / Y / Z" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Width="100" Text="{Binding PosX, ValidatesOnExceptions=True}" />
                                    <TextBox Width="100" Margin="8,0,0,0" Text="{Binding PosY, ValidatesOnExceptions=True}" />
                                    <TextBox Width="100" Margin="8,0,0,0" Text="{Binding PosZ, ValidatesOnExceptions=True}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Gold, second value" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="100" Text="{Binding Gold2, ValidatesOnExceptions=True}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="Not shown in the Camp menu. Equal to Gold in most saves." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Party -->
                <Grid x:Name="PageParty" Visibility="Collapsed" Margin="24,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource H1}" Text="Party" Margin="0,0,0,12" />
                        <ListBox x:Name="CharList" Grid.Row="1" Style="{StaticResource CardList}" SelectionChanged="OnCharSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <CheckBox x:Name="ShowAllRecords" Grid.Row="2" Margin="0,10,0,16" Checked="OnShowAll" Unchecked="OnShowAll"
                                  Content="Show other records" ToolTip="Second forms of the party (used after the story splits the party) and story guests" />
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CharDetail" Margin="24,0,28,24" MaxWidth="920" HorizontalAlignment="Left">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Width="220" FontSize="22" FontWeight="SemiBold" MaxLength="15" Text="{Binding Name, ValidatesOnExceptions=True}"
                                         ToolTip="Up to 6 characters, or a full party name such as Veronica (the save stores it as a code the patch expands)" />
                                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" Text="{Binding Subtitle}" />
                            </Grid>

                            <Border Style="{StaticResource CardBox}">
                                <Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource H2}" Text="Level and status" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Level" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Width="70" Text="{Binding Level, ValidatesOnExceptions=True}" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" Text="EXP follows the level" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="EXP" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Width="120" Text="{Binding Exp, ValidatesOnExceptions=True}" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding ExpHint}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="HP" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Width="70" Text="{Binding Hp, ValidatesOnExceptions=True}" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding MaxHp}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="MP" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox Width="70" Text="{Binding Mp, ValidatesOnExceptions=True}" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding MaxMp}" />
                                            <Button Content="Heal" Margin="14,0,0,0" Padding="10,2" MinHeight="26" Click="OnHeal"
                                                    ToolTip="Set HP and MP to at least the base maximum for this level" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Tactics" />
                                        <ComboBox x:Name="TacticsBox" Grid.Row="5" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                  SelectedIndex="{Binding Tactics}" />
                                        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Skill points" />
                                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="70" Text="{Binding SpAvailable, ValidatesOnExceptions=True}"
                                                     ToolTip="Unspent points, as the Skill Panel shows them" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding SpHint}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                                <Border Style="{StaticResource CardBox}">
                                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stats" Style="{StaticResource H2}" Margin="0" />
                                            <TextBlock Grid.Column="1" Text="Base" Style="{StaticResource Muted}" FontSize="11.5" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="Seeds" Style="{StaticResource Muted}" FontSize="11.5" TextAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="Total" Style="{StaticResource Muted}" FontSize="11.5" TextAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Stats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Base}" TextAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="2" Margin="8,0,0,0" MinHeight="22" Padding="4,1" TextAlignment="Right"
                                                                 Text="{Binding Seeds, ValidatesOnExceptions=True}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Total}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0"
                                                   Text="Base comes from the level table, seeds are stored per character. The game adds equipment and skill panels on top." />
                                    </StackPanel>
                                </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Equipment" />
                                    <ItemsControl ItemsSource="{Binding Equip}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SlotName}" />
                                                    <ComboBox Grid.Column="1" Width="420" HorizontalAlignment="Left"
                                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}"
                                                              IsEnabled="{Binding Enabled}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" Width="20" Height="20" Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Muted}" Text="Equipment comes from the character's own items below. A two-handed weapon also fills the shield slot." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource H2}" Text="Items" Margin="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" Text="{Binding ItemCount}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Add…" Style="{StaticResource Primary}" Click="OnInvAdd" IsEnabled="{Binding CanAddItem}" />
                                            <Button Content="Change…" Click="OnInvChange" />
                                            <Button Content="Remove" Click="OnInvRemove" />
                                            <Button Content="▲" Click="OnInvUp" ToolTip="Move up" Padding="10,5" />
                                            <Button Content="▼" Click="OnInvDown" ToolTip="Move down" Padding="10,5" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid x:Name="InvGrid" ItemsSource="{Binding Items}" IsReadOnly="True" MaxHeight="520"
                                              MouseDoubleClick="OnInvChange">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                                            <DataGridTemplateColumn Width="40" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                                            <DataGridTemplateColumn Header="Forged" Width="76">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding ForgeChoices}" SelectedIndex="{Binding ForgeLevel, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanForge}" MinHeight="24" Padding="6,1"
                                                                  ToolTip="Fun-Size Forge level (+1 to +3 are separate items in the save)" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                                            <DataGridTextColumn Header="Power" Binding="{Binding Power}" Width="80" />
                                            <DataGridTextColumn Header="Equipped" Binding="{Binding Equipped}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource H2}" Text="Skill panels" Margin="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" Text="{Binding PanelSummary}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Learn…" Style="{StaticResource Primary}" Click="OnPanelAdd" IsEnabled="{Binding CanAddPanel}" />
                                            <Button Content="Forget" Click="OnPanelRemove" />
                                            <Button Content="Spent = panel costs" Click="OnPanelSpend" Margin="0"
                                                    ToolTip="Set the spent skill points to what the learned panels cost" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid x:Name="PanelGrid" ItemsSource="{Binding Panels}" IsReadOnly="True" MaxHeight="400">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Panel" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="60" />
                                            <DataGridTextColumn Header="No." Binding="{Binding Id}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="Panels the character has learned, in order. Each board starts with one free panel. Learning panels from another character's board is untested." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <ContentControl x:Name="PageItemBag" Visibility="Collapsed" Margin="28,24" Content="{Binding ItemBag}" />
                <ContentControl x:Name="PageEquipBag" Visibility="Collapsed" Margin="28,24" Content="{Binding EquipBag}" />
                <ContentControl x:Name="PageKeyItems" Visibility="Collapsed" Margin="28,24" Content="{Binding KeyItems}" />
                <ContentControl x:Name="PageRecipes" Visibility="Collapsed" Margin="28,24" Content="{Binding Recipes}" />
                <ContentControl x:Name="PageMonsters" Visibility="Collapsed" Margin="28,24" Content="{Binding Monsters}" />
                <ContentControl x:Name="PageAccolades" Visibility="Collapsed" Margin="28,24" Content="{Binding AccoladeList}" />
                <ContentControl x:Name="PageItemList" Visibility="Collapsed" Margin="28,24" Content="{Binding ItemList}" />
                <ContentControl x:Name="PageStory" Visibility="Collapsed" Margin="28,24" Content="{Binding Progress.Story}" />
                <ContentControl x:Name="PageQuests" Visibility="Collapsed" Margin="28,24" Content="{Binding Progress.Quests}" />
                <ContentControl x:Name="PageZoom" Visibility="Collapsed" Margin="28,24" Content="{Binding Progress.Zoom}" />

                <!-- Flags and counters -->
                <Grid x:Name="PageFlags" Visibility="Collapsed" Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource H1}" Text="Flags and counters" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="The game's own switches and tallies. The game data has no names for them; each name says where the event scripts set the value (place: event), and the last column lists where it is set and checked." />
                    </StackPanel>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Global flags">
                            <ContentControl Margin="0,10,0,0" Content="{Binding Progress.GlobalFlags}" />
                        </TabItem>
                        <TabItem Header="Record counters">
                            <ContentControl Margin="0,10,0,0" Content="{Binding Progress.Counters}" />
                        </TabItem>
                        <TabItem Header="Tutorials">
                            <ContentControl Margin="0,10,0,0" Content="{Binding Progress.Tutorials}" />
                        </TabItem>
                        <TabItem Header="Record flags">
                            <ContentControl Margin="0,10,0,0" Content="{Binding Progress.RecordFlags}" />
                        </TabItem>
                        <TabItem Header="Cutscenes">
                            <ContentControl Margin="0,10,0,0" Content="{Binding Progress.Cutscenes}" />
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Raw data -->
                <Grid x:Name="PageRaw" Visibility="Collapsed" Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource H1}" Text="Raw data" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Every byte of the slot with what it is known to hold. Grey regions are not decoded yet. Click a region or a row to inspect and edit it." />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="RawTabs" Margin="0,0,14,0">
                            <TabItem Header="Regions">
                                <DataGrid x:Name="RegionGrid" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnRegionSelected">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Known}" Value="False">
                                                    <Setter Property="Foreground" Value="#8A909C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="120" />
                                        <DataGridTextColumn Header="Holds" Binding="{Binding Name}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Find value">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox x:Name="FindBox" Width="200" Style="{StaticResource SearchBox}" Tag="A number, e.g. your gold" KeyDown="OnFindKey" ToolTip="Finds the number as 8, 16 and 32-bit values." />
                                        <Button Content="Find" Margin="8,0,0,0" Click="OnFind" />
                                    </StackPanel>
                                    <DataGrid x:Name="FindGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnHitSelected">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="70" />
                                            <DataGridTextColumn Header="As" Binding="{Binding Kind}" Width="44" />
                                            <DataGridTextColumn Header="Where" Binding="{Binding Label}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Compare">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Compare with file…" Click="OnCompare" />
                                            <Button Content="Compare with the file on disk" Click="OnCompareDisk" Margin="0" />
                                        </StackPanel>
                                        <TextBlock x:Name="CompareInfo" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                                   Text="Save the game before and after doing something, then compare the two files to see which bytes changed." />
                                    </StackPanel>
                                    <DataGrid x:Name="DiffGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnHitSelected">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="70" />
                                            <DataGridTextColumn Header="Other" Binding="{Binding Before}" Width="90" />
                                            <DataGridTextColumn Header="This" Binding="{Binding After}" Width="90" />
                                            <DataGridTextColumn Header="Where" Binding="{Binding Label}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
                            <ListBox x:Name="HexList" BorderThickness="0" SelectionChanged="OnHexSelected"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Mono}" Text="{Binding OffsetText}" Foreground="#8A909C" Width="52" />
                                            <TextBlock Style="{StaticResource Mono}" Text="{Binding Hex}" Width="372" />
                                            <TextBlock Text="{Binding Label}" Foreground="#5A6272" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource CardBox}" Margin="0,14,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Offset 0x" Margin="0,0,4,0" />
                                <TextBox x:Name="InspOffset" Width="70" KeyDown="OnInspKey" LostFocus="OnInspOffsetChanged" />
                                <ComboBox x:Name="InspKind" Width="80" Margin="10,0,0,0" SelectionChanged="OnInspKindChanged" />
                                <TextBox x:Name="InspValue" Width="140" Margin="10,0,0,0" KeyDown="OnInspValueKey" />
                                <Button Content="Write" Margin="8,0,0,0" Click="OnInspWrite" />
                            </StackPanel>
                            <TextBlock x:Name="InspLabel" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,6">
                <Grid>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" FontSize="12" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
