<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SaveEditor</AssemblyName>
    <RootNamespace>SaveEditor</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>SaveEditor.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\favicon.png" />
    <Resource Include="Assets\icons.png" />
    <EmbeddedResource Include="Assets\icons.png" />
    <Resource Include="Assets\gamedata.json" />
    <EmbeddedResource Include="Assets\gamedata.json" />
  </ItemGroup>

  <!-- Optional external gamedata.json override for development/distribution -->
  <ItemGroup Condition="Exists('gamedata.json')">
    <None Include="gamedata.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
