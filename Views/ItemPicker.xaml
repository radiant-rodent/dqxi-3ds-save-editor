<Window x:Class="SaveEditor.ItemPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an item" Width="620" Height="620" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/app.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" Text="Choose an item" />
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Tag="Type part of a name or an item number" TextChanged="OnFilter" />
            <ComboBox x:Name="Category" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="OnFilter" />
        </Grid>
        <DataGrid x:Name="List" Grid.Row="2" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnSelection"
                  MouseDoubleClick="OnDoubleClick" KeyDown="OnListKey">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Icon}" Style="{StaticResource ItemIcon}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                <DataGridTextColumn Header="No." Binding="{Binding Id}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel x:Name="CountPanel" Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="Count" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CountBox" Width="70" Text="1" />
                </StackPanel>
                <StackPanel x:Name="ForgePanel" Orientation="Horizontal">
                    <TextBlock Text="Forged" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ForgeBox" Width="80" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" />
                <Button x:Name="OkButton" Content="Choose" Style="{StaticResource Primary}" IsDefault="True" Click="OnOk" Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
